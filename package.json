{
  "name": "codex_switch",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:macos-dmg": "tauri build --bundles app,dmg --no-sign && sh -c 'for f in src-tauri/target/release/bundle/dmg/*.dmg; do [ -e \"$f\" ] || exit 0; mv -f \"$f\" src-tauri/target/release/bundle/macos/; done'"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "typescript": "5.9.2",
    "vite": "7.1.4"
  }
}
